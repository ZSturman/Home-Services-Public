[Unit]
Description=Home Services %i job worker
After=local-fs.target
# Not bound to the gateway: jobs survive gateway restarts, and a storage
# worker failure cannot stop backup restores (or vice versa).

[Service]
Type=simple
User=home-services
Group=home-services
Environment=HOME_SERVICES_CONFIG=/etc/home-services/config.toml
WorkingDirectory=/var/lib/home-services
ExecStart=/opt/home-services/current/venv/bin/home-services worker %i
Restart=always
RestartSec=10
# SIGTERM: running restores stop restic and are recorded as interrupted.
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
