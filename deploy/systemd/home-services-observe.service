[Unit]
Description=Home Services observation sample (health log for acceptance)
After=home-services-gateway.service

[Service]
Type=oneshot
User=home-services
Group=home-services
Environment=HOME_SERVICES_CONFIG=/etc/home-services/config.toml
WorkingDirectory=/var/lib/home-services
ExecStart=/opt/home-services/current/venv/bin/home-services observe record
Nice=10
